# Conexión a PostgreSQL
DATABASE_URL="postgresql://rela:rela@localhost:5432/rela_entradas?schema=public"

# Secreto para firmar los códigos QR de las entradas (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
QR_ENTRADAS_SECRET="reemplaza-este-valor-por-un-secreto-largo-y-aleatorio"

# Usuario administrador inicial que crea `npm run db:seed`
SEED_ADMIN_NOMBRE="Administrador"
SEED_ADMIN_EMAIL="admin@rela.bo"
SEED_ADMIN_PASSWORD="cambia-esta-contrasena"

# Solo para `npm run test:integration` (usa una base de datos separada, se vacía en cada prueba)
TEST_DATABASE_URL="postgresql://rela:rela@localhost:5432/rela_entradas_test?schema=public"

# Google OAuth 2.0 Client ID (Obtenido desde Google Cloud Console para "Continuar con Google")
GOOGLE_CLIENT_ID=""

# Facebook App ID (Obtenido desde Meta for Developers para "Continuar con Facebook")
FACEBOOK_APP_ID=""
